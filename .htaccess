# Used only if the Plesk document root is the repository root instead of /public.
Options -Indexes
RewriteEngine On
RewriteRule ^(src|data|tests|docs|tools)(/|$) - [F,L]
RewriteRule ^(README\.md|config(\.example)?\.php|\.git.*)$ - [F,L]
RewriteCond %{REQUEST_URI} !/public/
RewriteRule ^(.*)$ public/$1 [L]
